# ---------------------------------------------------------------------------
# Nexora Destination — FRONTEND environment
#
# Copy this file to `.env.local` and fill in real values.
# Everything here is prefixed NEXT_PUBLIC_ and is therefore visible in the
# browser. Never put a secret, API key or database credential in this file.
# ---------------------------------------------------------------------------

# Base URL of the Express backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:5050

# Public site origin. Used for canonical URLs, Open Graph tags and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Company contact details.
#
# These are intentionally left blank. The UI hides or disables the relevant
# calls-to-action until real values are supplied — no placeholder number,
# address or email is ever invented in the code.
# ---------------------------------------------------------------------------

# Toll-free number in display format, e.g. "1800 123 4567".
NEXT_PUBLIC_TOLL_FREE_NUMBER=

# WhatsApp number in international format with country code, e.g. "+971 50 123 4567".
# Shows a floating WhatsApp chat button on phones. Leave empty to hide it.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public enquiries mailbox, e.g. "hello@example.com".
NEXT_PUBLIC_CONTACT_EMAIL=

# Registered office address, single line.
NEXT_PUBLIC_COMPANY_ADDRESS=

# Support hours shown beside the phone number, e.g. "Mon-Sat, 9am - 8pm IST".
NEXT_PUBLIC_SUPPORT_HOURS=

# Preselected country in the customer phone field, as an ISO 3166-1 alpha-2
# code (e.g. IN, GB, AE). Left blank on purpose: guessing a customer's country
# is worse than asking. See lib/countries.ts for supported codes.
NEXT_PUBLIC_DEFAULT_COUNTRY=


# Internal component reference at /design-system. Always available in
# development; returns 404 in production builds unless set to true.
# Leave unset for the public site.
NEXT_PUBLIC_ENABLE_DESIGN_SYSTEM=

# ---------------------------------------------------------------------------
# Flight Search Provider API (Flyventures Live Flight Search API)
#
# Development: http://localhost:5000/api
# Production:  https://api.flyventures.co/api (or your live backend URL)
#
# When left blank, Nexora operates in high-fidelity mock mode with full
# flight scheduling, route generation, price tiers, and baggage details.
# When provided, Nexora automatically routes searches to your live backend.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FLIGHT_API_URL=http://localhost:5000/api
NEXT_PUBLIC_FLIGHT_API_KEY=

