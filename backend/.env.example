# ---------------------------------------------------------------------------
# Nexora Destination — BACKEND environment
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. Every value below stays server-side — none of it is
# ever sent to the browser.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port the API listens on.
PORT=5050

# ---------------------------------------------------------------------------
# Database (required — the server will not start without it)
# ---------------------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/nexora_destination
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexora_destination?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nexora_destination

# ---------------------------------------------------------------------------
# CORS — which frontend origins may call this API.
# Comma-separate multiple origins. No trailing slashes.
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Brevo transactional email
#
# Create a key at https://app.brevo.com > SMTP & API > API Keys.
# The sender address must be a verified sender in your Brevo account.
#
# If these are left blank the API still accepts and stores inquiries, logs a
# warning, and sends no email. It never reports a false success.
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=support@nexoradestinations.com
BREVO_SENDER_NAME=Nexora Destination

# ---------------------------------------------------------------------------
# Where new inquiries are delivered
# ---------------------------------------------------------------------------
# Mailbox the travel team monitors — receives every new inquiry.
AGENT_EMAIL=support@nexoradestinations.com

# Toll-free number included in customer acknowledgement emails.
AGENT_PHONE_NUMBER=(888) 673-5008

# Set to false to disable outbound email without removing the credentials.
EMAIL_ENABLED=true

# ---------------------------------------------------------------------------
# Duffel Flight API (Live flight search and airline bookings)
#
# Create a token in your Duffel dashboard: https://duffel.com
# Use test token (duffel_test_...) or live token (duffel_live_...).
# When left blank, flight search returns high-fidelity fallback schedules.
# ---------------------------------------------------------------------------
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_VERSION=v2
