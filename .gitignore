# ---------------------------------------------------------------------------
# Nexora Destination — repository-wide ignore rules
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment files — never commit real secrets. Only *.example is tracked.
.env
.env.*
!.env.example

# Next.js build output
.next/
out/
build/
.vercel

# Backend build output
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing / coverage
coverage/
.playwright-mcp/
rd-*.png

# Editor & OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Certificates
*.pem
